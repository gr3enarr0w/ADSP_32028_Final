# AI Helpdesk Agent — Configuration Template
# Copy this file to .env and fill in your own values

# ── Atlassian Cloud ──
JSM_CLOUD_URL=https://<YOUR_DOMAIN>.atlassian.net

# ── OAuth 2.0 Configuration ──
ATLASSIAN_OAUTH_CLIENT_ID=<YOUR_OAUTH_CLIENT_ID>
ATLASSIAN_OAUTH_CLIENT_SECRET=<YOUR_OAUTH_CLIENT_SECRET>

# Optional: Secondary OAuth credential for additional scopes
ATLASSIAN_OAUTH2_CLIENT_ID=<YOUR_OAUTH2_CLIENT_ID>
ATLASSIAN_OAUTH2_CLIENT_SECRET=<YOUR_OAUTH2_CLIENT_SECRET>

# Atlassian Personal API Token
ATLASSIAN_API_TOKEN=<YOUR_ATLASSIAN_API_TOKEN>
ATLASSIAN_EMAIL=user@example.com

# ── Project Configuration ──
PROJECT_KEYS=<PROJECT_KEY>
CLOUD_CUTOVER_DATE=2026-01-01

# ── Google Cloud / Gemini AI ──
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GEMINI_PROJECT=your-gcp-project
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# ── Confluence ──
CONFLUENCE_KB_SPACE=<SPACE_KEY>
FAQ_CONFLUENCE_SPACES=<SPACE_KEY>

# ── Google Sheets ──
GOOGLE_SHEET_ID=<YOUR_GOOGLE_SHEET_ID>

# ── FAQ API ──
FAQ_API_TOKEN=<YOUR_FAQ_API_TOKEN>

# ── Auto-responder ──
AUTO_RESPOND_ASSIGNEES=<ASSIGNEE_ID>
AUTO_DRAFT_ALL=true

# ── Slack Integration (Optional) ──
# SLACK_BOT_TOKEN=<YOUR_SLACK_BOT_TOKEN>

# ── OpsGenie Integration (Optional) ──
OPSGENIE_TOKEN=<YOUR_OPSGENIE_TOKEN>
OPSGENIE_EMAIL=your-service-account@example.com

# ── Database ──
# DATABASE_URL=postgresql://user:password@localhost/helpdesk

# ── Security ──
DISABLE_DOCS=false
