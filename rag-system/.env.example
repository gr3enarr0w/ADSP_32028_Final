# .env.example — Shane's RAG config (copy to .env and edit).
# Everything is swappable here so the pipeline is model-agnostic (grading req).

# ---- Embeddings (index + query) -------------------------------------------
# provider: local | openai | hash
#   local  -> sentence-transformers, no API key (default, what we ship with)
#   openai -> needs OPENAI_API_KEY below
#   hash   -> offline deterministic embedder for tests/CI (not production)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
HASH_DIM=384

# ---- LLM (Answerer/Critic + prompt disclosure; teammates' nodes) ----------
# provider: anthropic | openai | google | bedrock | local
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# ---- Retrieval / hybrid fusion --------------------------------------------
TOP_K=5
CANDIDATE_K=25
RRF_K=60
HYBRID_ALPHA=0.5            # 1.0 = vector only, 0.0 = BM25 only
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Vector store ----------------------------------------------------------
VECTOR_STORE=qdrant        # qdrant (default) | chroma
COLLECTION=household_cleaning
# Qdrant (VECTOR_STORE=qdrant): leave QDRANT_URL blank for embedded local mode
# (no server needed); set it to use a Qdrant server / Qdrant Cloud.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Data paths ------------------------------------------------------------
# Point RAW_CSV at the real Kaggle file to index the full slice:
# RAW_CSV=data/raw/marketing_sample_for_amazon_com-ecommerce__20200101_20200131__10k_data.csv
RAW_CSV=data/raw/SAMPLE_amazon_household_cleaning.csv
PROCESSED_DIR=data/processed
INDEX_DIR=data/index

# ---- API keys (only if you switch providers) ------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
