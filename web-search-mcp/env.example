# Web Search MCP Configuration
# Copy this file to .env and fill in your API keys from each provider

# Exa Search API
# Get from: https://exa.ai
EXA_API_KEY=<your-exa-api-key>

# Brave Search API
# Get from: https://api.search.brave.com
BRAVE_SEARCH_API_KEY=<your-brave-api-key>
# Optional: Separate API key for Brave Answers API
# BRAVE_ANSWERS_API_KEY=<your-brave-answers-key>

# Tavily Search API
# Get from: https://tavily.com
TAVILY_API_KEY=<your-tavily-api-key>

# Linkup API (Company & Organization Research)
# Get from: https://linkup.so
LINKUP_API_KEY=<your-linkup-api-key>

# Newsdata API (News Aggregation)
# Get from: https://newsdata.io
NEWSDATA_API_KEY=<your-newsdata-api-key>

# Apify API (Web Scraping & Content Extraction)
# Get from: https://apify.com
APIFY_API_KEY=<your-apify-api-key>

# Google Cloud / Gemini Configuration (Optional)
# Only required if using Gemini provider for academic/deep searches
# Path to your GCP service account JSON file
GOOGLE_SERVICE_ACCOUNT_JSON=<path-to-service-account.json>
# Your GCP project ID (required if using Gemini)
GEMINI_PROJECT=<your-gcp-project-id>
# Optional: GCP region (default: global)
# GEMINI_LOCATION=us-central1
# Optional: Gemini model to use (default: gemini-3.1-pro-preview)
# GEMINI_MODEL=gemini-3.1-pro-preview
